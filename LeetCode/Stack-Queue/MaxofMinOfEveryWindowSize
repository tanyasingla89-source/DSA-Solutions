class Solution {
public:
    vector<int> maxOfMin(vector<int>& arr) {
        int n=arr.size();
        vector<int>len(n+1,0);
        vector<int>ans(n+1,0);
        stack<int>s;
        for(int i=0;i<arr.size();i++)
        {
            while(!s.empty() && arr[s.top()]>=arr[i])
            {
                int m=s.top();
                s.pop();
                int window = s.empty() ? i : i - s.top() - 1;
                len[window]=max(len[window],arr[m]);
            }
            s.push(i);
        }
        while(!s.empty())
        {
            int m=s.top();
            s.pop();
            int window;
            if(s.empty())
            {
                window=n;
            }
            else
            {
                window=n-s.top()-1;
            }
            len[window]=max(len[window],arr[m]);
        }
        for(int i=1;i<=n;i++)
        {
            ans[i]=len[i];
        }
        for(int i=n-1;i>=1;i--)
        {
            ans[i]=max(ans[i],ans[i+1]);
        }
        return ans;
    }
};
