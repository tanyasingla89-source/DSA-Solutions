class StockSpanner {
public:
 stack<int>s;
        int i=-1;
        vector<int>ans;
    StockSpanner() {
       
    }
    
    int next(int price) {
        i=i+1;
        ans.push_back(price);
        while(!s.empty() && price>=ans[s.top()])
        {
            s.pop();
        }
        int r=0;
        if(!s.empty())
        {
            r=i-s.top();
        }
        else
        {
            r=i+1;
        }
        s.push(i);
        return r;
        
    }
};

