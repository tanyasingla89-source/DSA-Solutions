class Solution {
public:
    vector<int> majorityElement(vector<int>& nums) {
        int cnt1=0;
        int cnt2=0;
        int c1=INT_MIN;
        int c2=INT_MIN;
        for(int i=0;i<nums.size();i++)
        {
            if(cnt1==0 && nums[i]!=c2)
            {
                cnt1=1;
                c1=nums[i];
            }
            else if(cnt2==0 && nums[i]!=c1)
            {
                cnt2=1;
                c2=nums[i];
            }
            else if(nums[i]==c1) cnt1++;
            else if(nums[i]==c2) cnt2++;
            else { cnt1--;
            cnt2--;}
        }
        cnt1=0;
        cnt2=0;
        vector<int>ans;
        for(int i=0;i<nums.size();i++)
        {
            if(c1==nums[i]) cnt1++;
            if(c2==nums[i]) cnt2++;
        }
        if(cnt1>nums.size()/3) ans.push_back(c1);
         if(cnt2>nums.size()/3) ans.push_back(c2);
         return ans;
    }
};
